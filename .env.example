# CATNIP configuration — copy to .env and edit. Every value is optional.
# NEVER put a private key, a seed phrase or an API key in this file or in .env.
# CATNIP_KEYPAIR is a PATH to a key file you create yourself, not a key.

# --- network ---------------------------------------------------------------
# devnet only. "mainnet-beta", or any RPC URL containing "mainnet", is refused
# at start-up and again inside the devnet executor.
CATNIP_CLUSTER=devnet
CATNIP_RPC_URL=https://api.devnet.solana.com

# Path to the devnet keypair used ONLY to pay devnet fees for the on-chain
# audit trail. Required for `--mode devnet` and `anchor-selftest`; ignored in
# paper mode. Create it with:
#   solana-keygen new -o ~/.config/solana/catnip-devnet.json
#   solana airdrop 2 $(solana-keygen pubkey ~/.config/solana/catnip-devnet.json) --url devnet
# Keep it outside this repository. Devnet SOL is free and has no value.
# CATNIP_KEYPAIR=/home/you/.config/solana/catnip-devnet.json

# Public key to check with `catnip verify` when you do not have the key file.
# CATNIP_PUBKEY=

# --- capital (paper USD) ---------------------------------------------------
CATNIP_STARTING_CASH_USD=1000
CATNIP_BASE_POSITION_PCT=8
CATNIP_MAX_POSITION_USD=150
CATNIP_MAX_POOL_SHARE_PCT=1.5
CATNIP_MAX_OPEN_POSITIONS=5
CATNIP_MAX_TOTAL_EXPOSURE_PCT=60
CATNIP_DAILY_LOSS_LIMIT_USD=200

# --- exits -----------------------------------------------------------------
CATNIP_TAKE_PROFIT_PCT=45
CATNIP_STOP_LOSS_PCT=18
CATNIP_TRAILING_STOP_PCT=22
CATNIP_MAX_HOLD_MINUTES=90
CATNIP_REENTRY_COOLDOWN_MINUTES=30

# --- safety filters --------------------------------------------------------
CATNIP_MIN_LIQUIDITY_USD=8000
CATNIP_MIN_VOLUME24H_USD=15000
CATNIP_MIN_HOLDERS=50
CATNIP_MAX_TOP_HOLDER_PCT=25
CATNIP_MIN_LP_BURNED_PCT=0

# Comma-separated mints the agent must never touch.
CATNIP_BLOCKLIST=

# --- execution model -------------------------------------------------------
CATNIP_TAKER_FEE_BPS=30
CATNIP_BASE_SLIPPAGE_BPS=50
CATNIP_PRIORITY_FEE_USD=0.02
CATNIP_TICK_SECONDS=30
